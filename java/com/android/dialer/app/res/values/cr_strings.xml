<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Preference titles -->
    <string name="other_settings_label">Other settings</string>

    <!-- Call recording -->
    <string name="call_recording_autostart_key" translatable="false">call_recording_autostart</string>
    <string name="call_recording_autostart_title">Autostart call recording</string>
    <string name="call_recording_autostart_mode_key" translatable="false">call_recording_autostart_mode</string>
    <string name="call_recording_autostart_mode_title">Auto recording mode</string>
    <string name="call_recording_autostart_mode_summary">%s. Per-contact settings take priority.</string>
    <string name="call_recording_autostart_mode_all">All calls</string>
    <string name="call_recording_autostart_mode_saved_contacts">Saved contacts</string>
    <string name="call_recording_autostart_mode_unknown_numbers">Unknown numbers (not saved)</string>

    <!-- Disable Proximity Options -->
    <string name="disable_proximity_sensor_title">Disable proximity sensor</string>
    <string name="disable_proximity_sensor_summary">Do not turn off touchscreen and display in call based on proximity sensor</string>

    <!-- Auto answer -->
    <string name="auto_answer_external_audio_title">Auto-answer on external audio</string>
    <string name="auto_answer_external_audio_summary">Automatically answer incoming calls when Bluetooth, wired, or USB audio is connected</string>

    <!-- Smart Options -->
    <string name="smart_category_title">Other options</string>
    <string name="smart_mute_title">Smart mute</string>
    <string name="smart_mute_summary">Mute the incoming call by flipping the device</string>

    <!-- Caller layout preference. The stored preference key remains fullscreen_caller_photo. -->
    <string name="fullscreen_caller_photo_title">Full Screen Caller</string>
    <string name="fullscreen_caller_photo_summary">Use a full-screen caller photo or avatar. Turn off to show a rounded avatar above the caller name and number.</string>
    <string name="hide_call_status_bar_title">Hide status bar on call screen</string>
    <string name="hide_call_status_bar_summary">Turn off to keep the status bar visible during calls</string>

    <!-- Dialer postcall -->
    <string name="enable_post_call_title">Post call snackbar</string>
    <string name="enable_post_call_summary">Enable post call notifications at the bottom of screen</string>
</resources>
